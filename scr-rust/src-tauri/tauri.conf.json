{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SCR Rust",
  "version": "2.3.0",
  "identifier": "br.com.scr.rust",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SCR — Sistema de Controle de Registro",
        "width": 1280,
        "height": 900,
        "minWidth": 760,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Sistema de Controle de Registro",
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
